 # Allocate default 80% heap for bazel
 startup --host_jvm_args=-XX:MaxRAMPercentage=80.0
+# Avoid Clang -fsplit-machine-functions BTI br x* faults on LTO_NONE while preserving CONFIG_ARM64_BTI_KERNEL=y
+build --//build/kernel/kleaf:defconfig_fragment=//soc-repo:no_autofdo_defconfig
