index 0fbb85f..a4552b7 100644
--- a/drivers/clk/qcom/dispcc-pineapple.c
+++ b/drivers/clk/qcom/dispcc-pineapple.c
@@ -1973,7 +1973,7 @@ static int disp_cc_pineapple_probe(struct platform_device *pdev)
 	 */
 	regmap_update_bits(regmap, 0xe054, BIT(0), BIT(0));
 
-	ret = qcom_cc_really_probe(pdev, &disp_cc_pineapple_desc, regmap);
+	ret = qcom_cc_really_probe(&pdev->dev, &disp_cc_pineapple_desc, regmap);
 	if (ret) {
 		dev_err(&pdev->dev, "Failed to register DISP CC clocks\n");
 		return ret;
diff --git a/drivers/clk/qcom/gcc-pineapple.c b/drivers/clk/qcom/gcc-pineapple.c
index 93d1790..2280037 100644
--- a/drivers/clk/qcom/gcc-pineapple.c
+++ b/drivers/clk/qcom/gcc-pineapple.c
@@ -4387,7 +4387,7 @@ static int gcc_pineapple_probe(struct platform_device *pdev)
 	/* Clear GDSC_SLEEP_ENA_VOTE to stop votes being auto-removed in sleep. */
 	regmap_write(regmap, 0x52150, 0x0);
 
-	ret = qcom_cc_really_probe(pdev, &gcc_pineapple_desc, regmap);
+	ret = qcom_cc_really_probe(&pdev->dev, &gcc_pineapple_desc, regmap);
 	if (ret) {
 		dev_err(&pdev->dev, "Failed to register GCC clocks\n");
 		return ret;
diff --git a/drivers/clk/qcom/gpucc-pineapple.c b/drivers/clk/qcom/gpucc-pineapple.c
index b0d1400..19b0b6d 100644
--- a/drivers/clk/qcom/gpucc-pineapple.c
+++ b/drivers/clk/qcom/gpucc-pineapple.c
@@ -662,7 +662,7 @@ static int gpu_cc_pineapple_probe(struct platform_device *pdev)
 	/* Enable frequency limiter irq */
 	regmap_write(regmap, 0x9534, 0x0);
 
-	ret = qcom_cc_really_probe(pdev, &gpu_cc_pineapple_desc, regmap);
+	ret = qcom_cc_really_probe(&pdev->dev, &gpu_cc_pineapple_desc, regmap);
 	if (ret) {
 		dev_err(&pdev->dev, "Failed to register GPU CC clocks\n");
 		return ret;
