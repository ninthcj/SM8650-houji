-				       hwmon_temp_min, tdata->index, low);
-		if (err && err != -EOPNOTSUPP)
-			return err;
-	}
-
-	if (info[i]->config[tdata->index] & HWMON_T_MAX) {
-		err = chip->ops->write(tdata->dev, hwmon_temp,
-				       hwmon_temp_max, tdata->index, high);
-		if (err && err != -EOPNOTSUPP)
-			return err;
-	}
-
-	return 0;
-}
