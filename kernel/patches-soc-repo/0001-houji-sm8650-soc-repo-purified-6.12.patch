--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -95,6 +95,15 @@ config SM_TCSRCC_PINEAPPLE
 	  Say Y if you want to support miscellaneous top-level clocks
 	  such as for the PHY references.
 
+config SM_DEBUGCC_PINEAPPLE
+	tristate "Pineapple Debug Clock Controller"
+	depends on COMMON_CLK_QCOM
+	help
+	  Support for the debug clock controller on Qualcomm Technologies, Inc
+	  Pineapple devices.
+	  Say Y if you want to support the debug clocks such as clock
+	  measurement functionality.
+
 config SM_CAMCC_SUN
         tristate "SUN Camera Clock Controller"
         depends on SM_GCC_SUN
diff --git a/drivers/clk/qcom/camcc-pineapple.c b/drivers/clk/qcom/camcc-pineapple.c
index a32dd71..1b10844 100644
--- a/drivers/clk/qcom/camcc-pineapple.c
+++ b/drivers/clk/qcom/camcc-pineapple.c
@@ -4095,7 +4095,7 @@ static int cam_cc_pineapple_probe(struct platform_device *pdev)
 	 */
 	regmap_update_bits(regmap, 0x132ec, BIT(0), BIT(0));
 
-	ret = qcom_cc_really_probe(pdev, &cam_cc_pineapple_desc, regmap);
+	ret = qcom_cc_really_probe(&pdev->dev, &cam_cc_pineapple_desc, regmap);
 	if (ret) {
 		dev_err(&pdev->dev, "Failed to register CAM CC clocks\n");
 		return ret;
