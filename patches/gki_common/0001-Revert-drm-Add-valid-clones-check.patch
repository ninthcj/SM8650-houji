From e8bc2fa52194bead9e3af6a647ebb7e2ad91444a Mon Sep 17 00:00:00 2001
From: yaap-houji <build@yaap-houji.local>
Date: Tue, 24 Nov 2026 14:40:16 -0400
Subject: [PATCH] Revert "drm: Add valid clones check"

Qualcomm prebuilt msm_drm.ko (OS3.0.307.0 / 6.1.68) performs Concurrent
Writeback (CWB) cloning for the under-display RGB ambient light sensor
without populating the writeback encoder bit in possible_clones.
Upstream commit ffb55ddf2685 (6.1.142+) rejects these commits with
-EINVAL, triggering SDM NullCommit screen flicker on Xiaomi 14 (houji).
Reverting this check restores the 6.1.0-6.1.141 android14-6.1 DRM KMI
behavioral contract with zero exported-symbol or security impact.
---
 drivers/gpu/drm/drm_atomic_helper.c | 28 ----------------------------
 1 file changed, 28 deletions(-)

diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index e737e45a3..66d223c2d 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -573,30 +573,6 @@ mode_valid(struct drm_atomic_state *state)
 	return 0;
 }
 
-static int drm_atomic_check_valid_clones(struct drm_atomic_state *state,
-					 struct drm_crtc *crtc)
-{
-	struct drm_encoder *drm_enc;
-	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state,
-									  crtc);
-
-	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask) {
-		if (!drm_enc->possible_clones) {
-			DRM_DEBUG("enc%d possible_clones is 0\n", drm_enc->base.id);
-			continue;
-		}
-
-		if ((crtc_state->encoder_mask & drm_enc->possible_clones) !=
-		    crtc_state->encoder_mask) {
-			DRM_DEBUG("crtc%d failed valid clone check for mask 0x%x\n",
-				  crtc->base.id, crtc_state->encoder_mask);
-			return -EINVAL;
-		}
-	}
-
-	return 0;
-}
-
 /**
  * drm_atomic_helper_check_modeset - validate state object for modeset changes
  * @dev: DRM device
@@ -768,10 +744,6 @@ drm_atomic_helper_check_modeset(struct drm_device *dev,
 		ret = drm_atomic_add_affected_planes(state, crtc);
 		if (ret != 0)
 			return ret;
-
-		ret = drm_atomic_check_valid_clones(state, crtc);
-		if (ret != 0)
-			return ret;
 	}
 
 	/*
